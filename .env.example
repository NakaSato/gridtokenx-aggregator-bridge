# GridTokenX Aggregator Bridge Environment Configuration
# Copy this file to .env and update the values

# ======================
# Redis Configuration
# ======================
REDIS_URL=redis://gridtokenx-redis.orb.local:6379

# ======================
# Postgres — durable meter-owner source of truth (read-only)
# ======================
# Shared gridtokenx Postgres, written by the meter-service registration API.
# The MeterRegistry uses it as tier-3 (after local cache + Redis) to resolve
# meter_serial -> (user_id, owner wallet) and backfills Redis on a hit, so a
# Redis flush/restart never loses ownership. Unreachable at boot => warn +
# disabled (Redis-only). Unset here means the 127.0.0.1:7001 dev default.
DATABASE_URL=postgresql://gridtokenx_user:gridtokenx_password@127.0.0.1:7001/gridtokenx

# DB-per-service Phase 2 seam. When set, used as the metering pool for the shared
# gridtokenx_meter DB and flips owner reads to the local meter_owner_read_model.
# Does NOT migrate at boot (a dedicated `cargo run --bin migrate` job owns that).
# Unset ⇒ legacy shared DATABASE_URL. Do NOT point at gridtokenx_meter until the
# read-model is populated (see docs/db-split-phase2.md).
# METER_DATABASE_URL=postgresql://gridtokenx_user:gridtokenx_password@127.0.0.1:7001/gridtokenx_meter

# ======================
# InfluxDB v2 — Independent realtime telemetry history
# ======================
# Dedicated to THIS service only — do NOT point at another service's InfluxDB.
# Unset INFLUXDB_URL ⇒ disabled (no history persisted). Unreachable at boot ⇒
# warn + disabled; realtime ingest (Redis path) is never blocked either way.
INFLUXDB_URL=http://gridtokenx-aggregator-influxdb.orb.local:8086
INFLUXDB_ORG=gridtokenx
INFLUXDB_BUCKET=aggregator_telemetry
INFLUXDB_TOKEN=aggregator-bridge-dev-token

# ======================
# Postgres meter_readings sink — optional, for dashboard "Recent Readings"
# ======================
# Mirrors the INFLUXDB_URL-gated sink: disabled by default, degrades safely
# when unset or DATABASE_URL's pool is unavailable. Batches readings into the
# shared meters/users join and writes to the IAM-owned meter_readings table.
# AGGREGATOR_PG_READINGS=true

# ======================
# Owner/wallet read-model feed (DB-per-service Phase 2) — optional, default OFF
# ======================
# Machinery that keeps the local meter_owner_read_model table current so a later
# cutover can drop the cross-domain meters⋈users(wallet_address) read. When ON:
# runs a one-time idempotent backfill from meters⋈users, then a Kafka consumer
# (topics below) applies meter + IAM wallet events. Requires DATABASE_URL +
# KAFKA_BOOTSTRAP_SERVERS; degrades safely (warn + no spawn) when either is absent.
# AGGREGATOR_OWNER_READMODEL_FEED=true
# READMODEL_METER_TOPIC=meter_events
# READMODEL_IAM_TOPIC=user_events
# Optional: separate brokers for the IAM user-events consumer (defaults to
# KAFKA_BOOTSTRAP_SERVERS when unset).
# READMODEL_IAM_BROKERS=localhost:9092

# ======================
# IoT Gateway Configuration
# ======================
# Port for IoT device ingestion (ESP32, etc.)
IOT_GATEWAY_PORT=4010

# gRPC Port for high-throughput telemetry ingestion. Canonical mesh port is 5030
# (code default); 50051 here is the local smart-meter-simulator override.
GRPC_PORT=50051

# Number of zone-partitioned Redis Streams the ingester fans readings across.
# IOT_NUM_ZONES=10

# API Keys for IoT device authentication
# Generate secure keys with: openssl rand -hex 16
# Multiple keys separated by commas
GRIDTOKENX_API_KEYS=edge-meter-key-001,ev-charger-key-002,battery-key-003

# ======================
# API Services (orchestrator) — where verified readings are forwarded
# ======================
# REST + gRPC of the API orchestrator (:4000). API_SERVICES_GRPC_URL defaults to
# API_SERVICES_URL when unset. (Note: the old API_GATEWAY_URL var is NOT read by
# this service — these two are.)
API_SERVICES_URL=http://127.0.0.1:4000
# API_SERVICES_GRPC_URL=http://127.0.0.1:4000

# ======================
# IAM Service Configuration
# ======================
# IAM gRPC (ConnectRPC) service for API key verification.
# This is IAM's host-mapped gRPC port (5010), NOT this service's GRPC_PORT —
# pointing it at our own port makes VerifyApiKey return `unimplemented` and
# every request silently falls back to GRIDTOKENX_API_KEYS.
IAM_SERVICE_URL=http://127.0.0.1:5010

# ======================
# Ingest Hot-Path Caches
# ======================
# In-process TTL caches that stop sustained ingest from re-hitting IAM/Redis/Postgres
# on every reading. Positive verdicts are trusted for the longer TTL; definitive
# negatives (rejected key / absent enckey-pubkey / unattributed meter) for the shorter
# one so a freshly provisioned/registered entity is picked up soon. All optional —
# defaults shown.
#
# API-key verdict cache (IAM VerifyApiKey). Negative caches definitive IAM *rejects*
# only; IAM connection errors are never cached (they fall back to GRIDTOKENX_API_KEYS).
API_KEY_POS_CACHE_TTL_SECS=60
API_KEY_NEG_CACHE_TTL_SECS=10
# Device pubkey cache (signature verify). SECURITY: the positive TTL IS the revocation
# latency — a key removed/rotated in Redis stays accepted up to this long. Keep short.
# (The signature itself is still verified on every reading; only the key fetch caches.)
PUBKEY_CACHE_TTL_SECS=60
PUBKEY_NEG_CACHE_TTL_SECS=10
# Device enckey cache (DLMS decrypt). Longer positive TTL is safe — key rotation goes
# through the versioned GUEK path, not this unversioned key.
DEVICE_ENCKEY_CACHE_TTL_SECS=300
DEVICE_ENCKEY_NEG_CACHE_TTL_SECS=10
# Meter-owner negative cache: how long an unregistered serial is remembered as
# "not found" before re-querying Redis + Postgres.
METER_REGISTRY_NEG_CACHE_TTL_SECS=30

# ======================
# Redis Stream Configuration
# ======================
# Primary event stream name. NOTE: not currently read by the service — dissemination
# uses zone-partitioned streams (see IOT_NUM_ZONES), not a single named stream.
# EVENT_STREAM_NAME=gridtokenx:events:v1

# Maximum entries per stream (approximate)
REDIS_STREAM_MAXLEN=100000

# Optional: AES-256-GCM encrypt the DeviceReading payload on the zone streams.
# AGGREGATOR_ENCRYPT_STREAMS=false

# ======================
# Kafka / RabbitMQ (downstream fan-out + dispatch trigger)
# ======================
# Kafka: MeterReadingEvent egress + GridStatusEvent dispatch trigger. Unset ⇒
# disabled (warn + no producer/consumer). Topics have defaults shown.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC_METER_READINGS=gridtokenx.meter.readings
# KAFKA_TOPIC_GRID_STATUS=gridtokenx.aggregator.grid_status
# RabbitMQ: optional reading fan-out. Unset ⇒ disabled.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ======================
# IAM auth circuit breaker (optional)
# ======================
# Trips the IAM VerifyApiKey path to the static-key fallback after repeated
# connection failures, then probes for recovery. Defaults shown.
# AGGREGATOR_IAM_CIRCUIT_BREAKER_ENABLED=true
# AGGREGATOR_IAM_CB_FAILURE_THRESHOLD=5
# AGGREGATOR_IAM_CB_COOLDOWN_SECS=30

# ======================
# Vault Transit — meter KEK (GUEK unwrap for versioned enckeys)
# ======================
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# VAULT_METER_KEK_NAME=gridtokenx-meter-kek
# VAULT_HTTP_TIMEOUT_SECS=5

# ======================
# Logging Configuration
# ======================
# Log level: trace, debug, info, warn, error
RUST_LOG=info,gridtokenx_aggregator_bridge=debug

# ======================
# Security Configuration
# ======================
# Deployment environment. `production` makes verification strict:
#   - Ed25519 signature checks enforced.
#   - Secure v4 DLMS frames MUST decrypt — a device with no AES key
#     (gridtokenx:devices:{meter_id}:enckey) is rejected, never decoded plaintext.
# ENVIRONMENT=production

# DEV ONLY. When set true (and NOT production), a secure v4 DLMS frame from a
# device that has no `enckey` in Redis is parsed as plaintext instead of skipped.
# Logged loud on every use. Leave unset/false outside local dev.
# ALLOW_PLAINTEXT_DLMS=false

# TLS/mTLS for the IoT gateway. HTTPS is served when BOTH IOT_GATEWAY_TLS_CERT
# and IOT_GATEWAY_TLS_KEY are set (there is no separate _ENABLED flag). Setting
# IOT_GATEWAY_TLS_CLIENT_CA additionally requires + verifies a client cert (mTLS).
# IOT_GATEWAY_TLS_CERT=/path/to/cert.pem
# IOT_GATEWAY_TLS_KEY=/path/to/key.pem
# IOT_GATEWAY_TLS_CLIENT_CA=/path/to/client-ca.pem

# Lock-down switch: neutralizes EVERY dev ingest bypass, fail-closed, regardless
# of the dev env vars below (SKIP_SIG_VERIFY, ALLOW_PLAINTEXT_DLMS,
# AGGREGATOR_ALLOW_UNVERIFIED_TELEMETRY, simulator bypass). Default false.
# AGGREGATOR_REQUIRE_SECURE=true

# DEV ONLY bypasses (all ignored when AGGREGATOR_REQUIRE_SECURE=true):
# Skip Ed25519 verify on the gRPC bulk path.
# SKIP_SIG_VERIFY=false
# Accept unsigned telemetry on the REST path.
# AGGREGATOR_ALLOW_UNVERIFIED_TELEMETRY=false

# ======================
# OpenADR 3 (OpenLEADR) Dispatch
# ======================
# When OPENLEADR_VTN_URL is set, the dispatch engine registers an "openleadr"
# adapter (preferred over "ieee") and publishes FLEX_UP/FLEX_DOWN as OpenADR 3
# events against the VTN. Unset = adapter disabled.
# Local VTN: superproject docker-compose service `openleadr-vtn` (port 4031,
# built from upstream openleadr-rs v0.2.4; dev creds bl-client/bl-client).
# OPENLEADR_VTN_URL=http://localhost:4031
# OAuth client credentials (both required to authenticate; omit for open VTNs)
# OPENLEADR_CLIENT_ID=
# OPENLEADR_CLIENT_SECRET=
# Existing program to attach events to; if unset, a program named
# OPENLEADR_PROGRAM_NAME (default: gridtokenx-flex-dispatch) is created.
# OPENLEADR_PROGRAM_ID=
# OPENLEADR_PROGRAM_NAME=gridtokenx-flex-dispatch
# Optional event target, e.g. GROUP:zone-1
# OPENLEADR_TARGET=
# Duration of each dispatch event in hours (default 1.0)
# OPENLEADR_EVENT_DURATION_HOURS=1.0

# VEN side: poll a (utility) VTN for DISPATCH_SETPOINT and DISPATCH_SETPOINT_RELATIVE
# events and execute them downstream. Setting OPENLEADR_VEN_VTN_URL enables the
# listener (relative setpoints tagged `executed_relative` on /metrics). Positive
# setpoint = FLEX_UP, negative = FLEX_DOWN. The downstream executor is
# OPENLEADR_VEN_DISPATCH_ADAPTER (ieee | grpc; default ieee — never openleadr,
# events would loop back to a VTN). Local VTN dev creds: ven-client-client-id /
# ven-client.
# OPENLEADR_VEN_VTN_URL=http://localhost:4031
# OPENLEADR_VEN_CLIENT_ID=
# OPENLEADR_VEN_CLIENT_SECRET=
# OPENLEADR_VEN_PROGRAM_ID=
# Only execute events carrying this target (e.g. a VEN/group name)
# OPENLEADR_VEN_TARGET=
# OPENLEADR_VEN_POLL_SECS=30
# OPENLEADR_VEN_DISPATCH_ADAPTER=ieee
# Executed-event dedup persists to REDIS_URL (hash
# gridtokenx:openleadr:ven:executed) so restarts don't re-execute events;
# falls back to RAM-only when Redis is absent.
# After each executed dispatch, an OpenADR report (AGGREGATED_REPORT resource,
# SETPOINT payload) confirms execution back to the VTN. Best-effort: a report
# failure never fails or retries the dispatch.
# OPENLEADR_VEN_REPORTS=true
# OPENLEADR_VEN_CLIENT_NAME=gridtokenx-aggregator-bridge
# At startup the listener self-registers a VEN object named
# OPENLEADR_VEN_CLIENT_NAME on the VTN (needs the `write_vens_ven` scope;
# best-effort — a failure is logged and polling proceeds unregistered).
# Set false when the VTN operator provisions the VEN out-of-band.
# OPENLEADR_VEN_REGISTER=true
# gRPC edge dispatch target: used by the dispatch engine's "grpc" adapter and
# by the VEN listener when OPENLEADR_VEN_DISPATCH_ADAPTER=grpc.
# DISPATCH_GRPC_URL=http://127.0.0.1:50051

# Dispatch engine tuning. DISPATCH_ADAPTERS (csv) fans each excursion out to
# EVERY listed adapter at once — e.g. a downstream in-mesh VTN AND a utility VTN.
# Names: grpc|ieee|openleadr. One adapter erroring never stops the others (Err
# only when all fail). Unknown names are dropped loud.
# DISPATCH_ADAPTERS=openleadr,grpc
# Legacy single-value form, still honored as a one-element list (back-compat).
# Used only when DISPATCH_ADAPTERS is unset. Default: openleadr when configured,
# else ieee. Frequency thresholds drive FLEX_UP (below low) / FLEX_DOWN (above
# high); capacity is the kW setpoint.
# DISPATCH_ADAPTER=openleadr
# DISPATCH_FREQ_LOW_HZ=49.8
# DISPATCH_FREQ_HIGH_HZ=50.2
# DISPATCH_CAPACITY_KW=100.0
# Repeat-suppression, tracked PER (ACTION, ADAPTER): the same action to the same
# adapter re-dispatches only after this many seconds (default 900 = one 15-minute
# aggregation window). A flipped action (FLEX_UP <-> FLEX_DOWN), or the same
# action to a DIFFERENT fan-out adapter, fires immediately on its own independent
# timer — but oscillating between directions cannot reset either cooldown, and
# one fan-out target cannot suppress another.
# Failed dispatches retry on the next grid-status message.
# DISPATCH_COOLDOWN_SECS=900

# ======================
# Performance Tuning
# ======================
# NOTE: the INGESTER_* vars below are NOT currently read by the service (no code
# path consumes them). Left as documentation of intended knobs only.
# INGESTER_WORKERS=4
# INGESTER_BATCH_SIZE=10
# INGESTER_BLOCK_TIMEOUT_MS=2000

# ----------------------------------------------------------------------------
# Surplus token minting (Chain Bridge over NATS)
# ----------------------------------------------------------------------------
# When a 15-minute billing window closes with net surplus generation
# (energy_generated > energy_consumed), the settlement sink mints that surplus
# to the meter owner's wallet by sending intent to Chain Bridge over NATS.
# Fire-and-forget; the bridge dedups replays by mint:{serial}:{window_start_ms}.
#
# NATS server (unset → minting disabled, service still runs)
# NATS_URL=nats://127.0.0.1:4222
# Enable the mint path (needs NATS_URL). Default false.
# MINT_VIA_CHAIN_BRIDGE=true
# SPIFFE identity asserted to Chain Bridge for mint RBAC.
# CHAIN_BRIDGE_SERVICE_IDENTITY=spiffe://gridtokenx.th/prod/aggregator-bridge
#
# Recipient wallet is resolved from the meter registry at
# gridtokenx:meters:{serial}:wallet (Redis). The registration flow
# (meter-service / IAM) must populate it, else the mint is skipped.
#
# Settlement flush loop (peeks completed bins → billing point + surplus mint →
# evict). Runs when InfluxDB OR minting is enabled.
# BILLING_FLUSH_INTERVAL_SECS=30
# BILLING_FLUSH_GRACE_SECS=120
# Request/reply timeout awaiting the Chain Bridge mint reply.
# AGGREGATOR_MINT_REPLY_TIMEOUT_SECS=10
# Batch size + in-flight cap for the mint outbox drain.
# AGGREGATOR_MINT_BATCH_SIZE=32
# MINT_INFLIGHT_LIMIT=64
# Durable mint outbox drain cadence + park age (entry unlanded past max-age is
# parked, not deleted; 0 = retry forever).
# MINT_RETRY_INTERVAL_SECS=30
# MINT_OUTBOX_MAX_AGE_SECS=604800
#
# Durable in-flight billing bins (write-through to Redis for crash recovery).
# Default on when Redis is reachable; false forces memory-only.
# DURABLE_BINS=true

# ----------------------------------------------------------------------------
# Grid-status publisher (drives the dispatch trigger)
# ----------------------------------------------------------------------------
# Rolling window used to compute grid frequency, and how often a GridStatusEvent
# is published to KAFKA_TOPIC_GRID_STATUS.
# GRID_FREQ_WINDOW_SECS=60
# GRID_STATUS_PUBLISH_SECS=15

# Platform gRPC client target (reads/forwarding). DISPATCH_GRPC_URL is set in the
# OpenADR section below.
# PLATFORM_GRPC_URL=http://127.0.0.1:50051
